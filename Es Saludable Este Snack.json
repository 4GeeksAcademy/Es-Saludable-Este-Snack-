    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst nutriscoreItem = items.find(i => i.json.nutriscore_verdict !== undefined);\nconst semaforoItem = items.find(i => i.json.calculate !== undefined);\n\nconst priority = { healthy: 1, moderate: 2, unhealthy: 3 };\n\nconst results = [];\nif (semaforoItem) results.push(semaforoItem.json.calculate);\nif (nutriscoreItem && nutriscoreItem.json.nutriscore_verdict !== 'unknown') {\n  results.push(nutriscoreItem.json.nutriscore_verdict);\n}\n\nconst final_verdict = results.reduce((worst, current) =>\n  priority[current] > priority[worst] ? current : worst\n);\n\nreturn [{\n  json: {\n    concern_score: semaforoItem ? semaforoItem.json.count : null,\n    semaforo_verdict: semaforoItem ? semaforoItem.json.calculate : null,\n    nutriscore_verdict: nutriscoreItem ? nutriscoreItem.json.nutriscore_verdict : null,\n    final_verdict: final_verdict,\n    product_name: (semaforoItem || nutriscoreItem)?.json.product_name,\n    brands: (semaforoItem || nutriscoreItem)?.json.brands,\n    sugars_100g: (semaforoItem || nutriscoreItem)?.json.sugars_100g,\n    salt_100g: (semaforoItem || nutriscoreItem)?.json.salt_100g,\n    fat_100g: (semaforoItem || nutriscoreItem)?.json.fat_100g,\n    nutriscore_grade: (semaforoItem || nutriscoreItem)?.json.nutriscore\n  }\n}];;"
      },
